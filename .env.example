# AirGuard India -- live ingestion credentials.
#
# Copy this file to `.env` in the same folder and fill in the values.
# `.env` is ignored by Git. Never commit it, never paste its contents anywhere,
# and never give any of these a NEXT_PUBLIC_ prefix: they are server-side only.

# Official CPCB feed on data.gov.in. Free key: https://www.data.gov.in (My Account -> API key)
DATA_GOV_API_KEY=

# OpenAQ v3. Free key: https://explore.openaq.org (Account -> API key)
OPENAQ_API_KEY=

# NASA FIRMS active-fire data. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# PostgreSQL connection string. For Supabase: open the project, press "Connect",
# and copy the whole "Session pooler" line. It already contains your project's
# own reference and server address; only the password has to be typed in.
# Its shape is
#   postgresql://postgres.<20 letters>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The words PROJECT_REF and POOLER_HOST are not values. A string that still
# contains them is refused.
DATABASE_URL=

# --- Optional overrides (defaults shown; see docs/airguard2/live_data_implementation.md) ---
# DATA_GOV_AQI_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
# AIRGUARD_FRESH_MINUTES=90
# AIRGUARD_STALE_MINUTES=180
# AIRGUARD_UNAVAILABLE_HOURS=24
# AIRGUARD_WEATHER_MODEL=gfs_seamless
# AIRGUARD_FIRMS_DAY_RANGE=1
