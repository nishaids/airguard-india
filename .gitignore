# --- raw and intermediate data --------------------------------------------- #
# Raw CSVs are large and are regenerated by `python -m src.data.acquire`.
# PROVENANCE.json is the audit artefact and IS tracked.
data/raw/*.csv
data/raw/*.zip
!data/raw/PROVENANCE.json
data/interim/*
# Bulk hourly archive pulled from OpenAQ: large, regenerable from the recorded
# run parameters, and not a source of truth for any published number.
data/archive/*
# Raw research caches (OpenAQ hours, CAMS and weather archives): large, immutable,
# checksummed in committed manifests under results/research/data_manifests.
data/research/*
!data/interim/.gitkeep
data/processed/*.csv
data/processed/*.parquet
!data/processed/.gitkeep

# --- model artefacts -------------------------------------------------------- #
# Small joblib artefacts required by the deployed app are force-added; anything
# above the GitHub soft limit stays out of the repository.
models/*.joblib.large

# --- secrets ---------------------------------------------------------------- #
# Credentials live only in .env (or the scheduler's secret store). The template
# with variable names and no values is the one env file that is tracked.
.env
.env.*
!.env.example

# --- python ----------------------------------------------------------------- #
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-live/
venv/
env/
.ipynb_checkpoints/

# --- tooling / os ----------------------------------------------------------- #
.streamlit/secrets.toml
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
# Runtime-only mutex/lease; evidence remains in continuation_status/workers.json.
results/research/continuation.lock
results/research/continuation.lock.guard
webapp/test-results/
webapp/playwright-report/
supabase/.temp/
*.tsbuildinfo
results/ingestion.log.*

# Webfont cache for the explainer PDF; refetched on demand.
reports/.fontcache/

# Local diagnostics/toolchains stay on disk; vetted evidence may be force-added.
logs/
paper/conference_final/*.aux
paper/conference_final/*.blg
paper/conference_final/main.bbl
paper/conference_final/review/
paper/conference/main.blg
paper/journal/main.blg
paper/station_calibration_skeleton.pdf
results/research/extensions/**/*.parquet
results/release/codex_push_receipt.json
